# Copy this file to `.env` and fill in your FREE-TIER keys.
# The app runs perfectly fine with this file missing or empty —
# every service class falls back to curated mock data automatically.

# Groq Cloud (Llama 3 free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini free tier (optional alternate AI engine) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TMDB (The Movie Database, 100% free w/ attribution) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Last.fm (free/unrestricted metadata) — https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Supabase (free tier project) — https://app.supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
