{
  "expo": {
    "name": "Krimie",
    "slug": "krimie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./branding/icons/Icon-512.png",
    "scheme": "krimie",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./branding/icons/Icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.krimie.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./branding/icons/Icon-512.png",
        "backgroundColor": "#0B0B12"
      },
      "package": "app.krimie.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./branding/icons/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
